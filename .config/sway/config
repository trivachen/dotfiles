# ╔════════════════════════════════════════════════════════════════════╗
# ║                         THEME AND OUTPUT                           ║
# ╚════════════════════════════════════════════════════════════════════╝

# Load colors generated by pywal.
include ~/.cache/wal/colors-sway

# Apply the current pywal wallpaper to every output.
output * bg $wallpaper fill


# ╔════════════════════════════════════════════════════════════════════╗
# ║                            VARIABLES                               ║
# ╚════════════════════════════════════════════════════════════════════╝

# Main modifier key: Super / Windows key.
set $mod Mod4

# Vim-style directions, used for focus, movement, and resizing.
set $left  h
set $down  j
set $up    k
set $right l

# Commonly used applications and launch commands.
set $term    alacritty
set $browser flatpak run io.gitlab.librewolf-community
set $menu    wofi --show drun


# ╔════════════════════════════════════════════════════════════════════╗
# ║                         WINDOW APPEARANCE                          ║
# ╚════════════════════════════════════════════════════════════════════╝

# Open new workspaces with a tabbed layout.
workspace_layout tabbed

# Set the cursor theme for the primary seat.
seat seat0 xcursor_theme Bibata-Modern-Ice

# Use compact pixel borders instead of title bars.
font                      Iosevka Nerd Font 12
default_border            pixel 2
default_floating_border   pixel 2
hide_edge_borders         smart
titlebar_padding          8 1

# Client color order:
# border | background | text | indicator | child border
client.focused          $foreground $foreground $background $foreground $foreground
client.focused_inactive $background $background $foreground $background $background
client.unfocused        $background $background $foreground $background $background
client.urgent           $foreground $foreground $background $foreground $foreground
client.placeholder      $background $background $foreground $background $background

# ╔════════════════════════════════════════════════════════════════════╗
# ║                           SWAYFX EFFECTS                           ║
# ╚════════════════════════════════════════════════════════════════════╝

# Enable blur and tune its sampling quality.
blur        on
blur_xray   off
blur_passes 4
blur_radius 5

layer_effects "waybar" {
    blur enable
    blur_ignore_transparent enable
}

layer_effects "wofi" {
    blur enable
    blur_ignore_transparent enable
}


# ╔════════════════════════════════════════════════════════════════════╗
# ║                           STATUS BAR                               ║
# ╚════════════════════════════════════════════════════════════════════╝

# Waybar runs as the status command; keep Sway's own bar hidden.
bar {
    status_command waybar
    mode          invisible
}


# ╔════════════════════════════════════════════════════════════════════╗
# ║                            AUTOSTART                               ║
# ╚════════════════════════════════════════════════════════════════════╝

# Set the initial display brightness.
exec brightnessctl s 20%

# Start or restart these services whenever the config is reloaded.
exec_always syncthing --no-browser
# exec_always dbus-run-session pulseaudio --daemonize=no --exit-idle-time=1
exec_always dbus-run-session udiskie
exec_always emacs --daemon
exec_always kdeconnectd
exec_always mako --ignore-timeout 0 --default-timeout 3000
exec_always mpd
exec_always mpdris2-rs
exec_always playerctld
exec_always wlsunset -S 7:00 -s 19:00


# ╔════════════════════════════════════════════════════════════════════╗
# ║                       APPLICATION SHORTCUTS                        ║
# ╚════════════════════════════════════════════════════════════════════╝

bindsym $mod+q              exec $term
bindsym $mod+Return         exec emacsclient -c
bindsym $mod+Shift+Return   exec emacsclient --eval '(emacs-everywhere)'
bindsym $mod+r              exec $menu
bindsym $mod+Tab            exec gtklock


# ╔════════════════════════════════════════════════════════════════════╗
# ║                       WINDOW MANAGEMENT                            ║
# ╚════════════════════════════════════════════════════════════════════╝

# Close the focused window, toggle floating mode, reload, or exit Sway.
bindsym $mod+Shift+d        kill
bindsym $mod+Shift+space    floating toggle
bindsym $mod+Ctrl+r         reload
bindsym $mod+Shift+Ctrl+q   exec swaymsg exit


# ╔════════════════════════════════════════════════════════════════════╗
# ║                        FOCUS AND MOVEMENT                          ║
# ╚════════════════════════════════════════════════════════════════════╝

# Focus windows using either Vim keys or the arrow keys.
bindsym $mod+$left          focus left
bindsym $mod+$down          focus down
bindsym $mod+$up            focus up
bindsym $mod+$right         focus right

bindsym $mod+Left           focus left
bindsym $mod+Down           focus down
bindsym $mod+Up             focus up
bindsym $mod+Right          focus right

# Switch focus between tiling and floating windows; focus the parent container.
bindsym $mod+Space          focus mode_toggle
bindsym $mod+A              focus parent

# Move the focused window with Vim keys or the arrow keys.
bindsym $mod+Shift+$left    move left
bindsym $mod+Shift+$down    move down
bindsym $mod+Shift+$up      move up
bindsym $mod+Shift+$right   move right

bindsym $mod+Shift+Left     move left
bindsym $mod+Shift+Down     move down
bindsym $mod+Shift+Up       move up
bindsym $mod+Shift+Right    move right


# ╔════════════════════════════════════════════════════════════════════╗
# ║                          WORKSPACES                                ║
# ╚════════════════════════════════════════════════════════════════════╝

# Switch to workspaces 1–10.
bindsym $mod+1              workspace number 1
bindsym $mod+2              workspace number 2
bindsym $mod+3              workspace number 3
bindsym $mod+4              workspace number 4
bindsym $mod+5              workspace number 5
bindsym $mod+6              workspace number 6
bindsym $mod+7              workspace number 7
bindsym $mod+8              workspace number 8
bindsym $mod+9              workspace number 9
bindsym $mod+0              workspace number 10

# Send the focused window to workspaces 1–10.
bindsym $mod+Shift+1        move container to workspace number 1
bindsym $mod+Shift+2        move container to workspace number 2
bindsym $mod+Shift+3        move container to workspace number 3
bindsym $mod+Shift+4        move container to workspace number 4
bindsym $mod+Shift+5        move container to workspace number 5
bindsym $mod+Shift+6        move container to workspace number 6
bindsym $mod+Shift+7        move container to workspace number 7
bindsym $mod+Shift+8        move container to workspace number 8
bindsym $mod+Shift+9        move container to workspace number 9
bindsym $mod+Shift+0        move container to workspace number 10


# ╔════════════════════════════════════════════════════════════════════╗
# ║                     LAYOUT AND SCRATCHPAD                          ║
# ╚════════════════════════════════════════════════════════════════════╝

bindsym $mod+v              split
bindsym $mod+Ctrl+e         layout toggle split
bindsym $mod+f              fullscreen

# Move the focused window to the scratchpad or show a scratchpad window.
bindsym $mod+Shift+s        move scratchpad
bindsym $mod+s              scratchpad show


# ╔════════════════════════════════════════════════════════════════════╗
# ║                     MEDIA AND BRIGHTNESS                           ║
# ╚════════════════════════════════════════════════════════════════════╝

# Control the default audio output and active media player.
bindsym XF86AudioMute           exec pulsemixer --toggle-mute
bindsym XF86AudioLowerVolume    exec pulsemixer --change-volume -5
bindsym XF86AudioRaiseVolume    exec pulsemixer --change-volume +5
bindsym XF86AudioPlay           exec playerctl play-pause -s
bindsym XF86AudioPause          exec playerctl play-pause -s
bindsym XF86AudioNext           exec playerctl next -s
bindsym XF86AudioPrev           exec playerctl previous -s

# Adjust screen brightness in 5% steps.
bindsym XF86MonBrightnessDown   exec brightnessctl s 5%-
bindsym XF86MonBrightnessUp     exec brightnessctl s +5%


# ╔════════════════════════════════════════════════════════════════════╗
# ║                          SCREENSHOTS                              ║
# ╚════════════════════════════════════════════════════════════════════╝

# Select an area and copy the screenshot to the clipboard.
bindsym Print exec grimshot copy area


# ╔════════════════════════════════════════════════════════════════════╗
# ║                       INPUT CONFIGURATION                          ║
# ╚════════════════════════════════════════════════════════════════════╝

input "type:keyboard" {
    # Switch between US and Russian layouts with Right Ctrl.
    xkb_layout  us,ru
    xkb_options grp:rctrl_toggle,caps:ctrl_modifier
}

input "type:touchpad" {
    tap             enabled
    dwt             disable
    natural_scroll  enabled
    accel_profile   "adaptive"
    pointer_accel   0.24
}


# ╔════════════════════════════════════════════════════════════════════╗
# ║                         TOUCHPAD GESTURES                          ║
# ╚════════════════════════════════════════════════════════════════════╝

# Swipe horizontally to move between workspaces.
bindgesture swipe:left  workspace next
bindgesture swipe:right workspace prev


# ╔════════════════════════════════════════════════════════════════════╗
# ║                            RESIZE MODE                             ║
# ╚════════════════════════════════════════════════════════════════════╝

# Enter this mode with Super+Shift+R.
# Use Vim keys or arrow keys to resize the focused container.
mode "resize" {
    bindsym $left     resize shrink width  8px
    bindsym $down     resize grow   height 8px
    bindsym $up       resize shrink height 8px
    bindsym $right    resize grow   width  8px

    bindsym Left      resize shrink width  8px
    bindsym Down      resize grow   height 8px
    bindsym Up        resize shrink height 8px
    bindsym Right     resize grow   width  8px

    bindsym Return    mode "default"
    bindsym Escape    mode "default"
}

bindsym $mod+Shift+r mode "resize"


# ╔════════════════════════════════════════════════════════════════════╗
# ║                      APPLICATION LAUNCHER MODE                     ║
# ╚════════════════════════════════════════════════════════════════════╝

# Enter this mode with Super+Shift+A, then press a letter to launch an app.
mode "run" {
    bindsym b         exec $browser
    bindsym k         exec kdeconnect-app
    bindsym p         exec prismlauncher
    bindsym l         exec localsend

    bindsym Return    mode "default"
    bindsym Escape    mode "default"
}

bindsym $mod+Shift+a mode "run"
